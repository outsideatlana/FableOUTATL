# OutsideAtl — environment configuration
# ---------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------

# ---- Supabase (public — safe to expose to the browser) --------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---- Supabase (server-only secrets — NEVER expose client-side) -
# The service role key bypasses Row Level Security. Server use only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Public Supabase Storage bucket for images (events, recaps, hosted logos).
SUPABASE_STORAGE_BUCKET=media

# ---- Admin login (server-only) --------------------------------
# Verified server-side with bcrypt; a signed httpOnly cookie holds the
# session. The browser never sees the username, hash, or secret.
# Generate the hash:  npm run hash-password -- "yourStrongPassword"
# IMPORTANT: bcrypt hashes contain "$". Next.js (@next/env) expands $VAR in
# .env files, which corrupts the hash. ESCAPE EACH "$" AS "\$" here — e.g.
#   ADMIN_PASSWORD_HASH=\$2a\$10\$abcd...
# (single quotes are NOT reliable). The hash-password script prints a ready-
# to-paste line. In the Vercel dashboard, paste the RAW hash (no escaping).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=\$2a\$10\$replace_with_bcrypt_hash
# Long random string used to sign the session JWT.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret

# ---- Airtable (server-only) -----------------------------------
# ENABLE_AIRTABLE_SYNC gates the OPTIONAL mirroring of Supabase-backed forms
# (RSVPs, signups, applications, events, recaps) to Airtable.
#
# NOTE: the "What should we throw next?" interest form is DIFFERENT — Airtable
# INTEREST FORMS is its PRIMARY (and only) store. It submits to Airtable
# whenever AIRTABLE_API_KEY + AIRTABLE_BASE_ID are set, regardless of the flag.
# AIRTABLE_API_KEY is server-only and must NEVER be exposed client-side.
ENABLE_AIRTABLE_SYNC=false
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=appfq5XK6vJpwDCyg
AIRTABLE_EVENTS_TABLE=Events
AIRTABLE_RSVP_TABLE=RSVPs
AIRTABLE_APPLICATIONS_TABLE=Applications
AIRTABLE_RECAPS_TABLE=Recaps
AIRTABLE_SIGNUPS_TABLE=Signups
AIRTABLE_INTEREST_TABLE=INTEREST FORMS
