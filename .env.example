# OutsideAtl — environment configuration
# ---------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------

# ---- Supabase (public — safe to expose to the browser) --------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---- Site logos (public — served from the Supabase `media` bucket) -----
# Used for the favicon (main logo) and the header/footer branding (transparent
# logo). Code falls back to these exact URLs if the vars are unset, so a missing
# var can never break the brand. Do NOT use Vercel Blob — Supabase owns media.
NEXT_PUBLIC_OUTSIDEATL_LOGO_URL=https://dpenkeevywzfqapqubso.supabase.co/storage/v1/object/public/media/outsideatllogo.jpg
NEXT_PUBLIC_OUTSIDEATL_TRANSPARENT_LOGO_URL=https://dpenkeevywzfqapqubso.supabase.co/storage/v1/object/public/media/transparentoalogo.png

# ---- Supabase (server-only secrets — NEVER expose client-side) -
# The service role key bypasses Row Level Security. Server use only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Public Supabase Storage bucket for images (events, recaps, hosted logos, site
# logos). The provided logo URLs above live in this `media` bucket — keep this
# value as `media` (the spec's `outsideatl-media` would point at a bucket that
# does not exist and break uploads/serving).
SUPABASE_STORAGE_BUCKET=media

# ---- Admin login (server-only) --------------------------------
# Verified server-side with bcrypt; a signed httpOnly cookie holds the
# session. The browser never sees the username, hash, or secret.
# Generate the hash:  npm run hash-password -- "yourStrongPassword"
# IMPORTANT: bcrypt hashes contain "$". Next.js (@next/env) expands $VAR in
# .env files, which corrupts the hash. ESCAPE EACH "$" AS "\$" here — e.g.
#   ADMIN_PASSWORD_HASH=\$2a\$10\$abcd...
# (single quotes are NOT reliable). The hash-password script prints a ready-
# to-paste line. In the Vercel dashboard, paste the RAW hash (no escaping).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=\$2a\$10\$replace_with_bcrypt_hash
# Long random string used to sign the session JWT.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret

# ---- Airtable (server-only) -----------------------------------
# Airtable is the store for ALL site form submissions. Every form posts to a
# same-origin /api route which writes to Airtable server-side (lib/airtable/
# client.ts). AIRTABLE_API_KEY is server-only and must NEVER reach the browser.
#
# Only AIRTABLE_API_KEY is strictly required: the base id falls back to the
# known base, and each *_TABLE value falls back to that table's stable Airtable
# table ID, so a missing/mis-cased table name can never break a form.
#
# Table names below are the EXACT names in the base (case-sensitive in the API):
# the base uses "RSVPs", "Signups", "Interest Forms", "Dj" — not RSVPS/SIGNUPS/
# INTEREST FORMS/DJ. If you prefer, you may set any value to the table ID.
#
# ENABLE_AIRTABLE_SYNC only gates the OPTIONAL mirroring of admin-managed
# Events/Recaps (Supabase is their source of truth); it does NOT affect forms.
ENABLE_AIRTABLE_SYNC=false
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=appfq5XK6vJpwDCyg
AIRTABLE_RSVP_TABLE=RSVPs
AIRTABLE_SIGNUPS_TABLE=Signups
AIRTABLE_APPLICATIONS_TABLE=Applications
AIRTABLE_INTEREST_TABLE=Interest Forms
AIRTABLE_INTERNS_TABLE=Interns
AIRTABLE_VENDORS_TABLE=Vendors
AIRTABLE_DJ_TABLE=Dj
# Sponsor applications submit here (NOT Vendors). The Airtable API is
# case-sensitive: the real table is "Sponsors", not "SPONSORS". If unset, the
# code falls back to the stable table ID, so this can never misroute.
AIRTABLE_SPONSORS_TABLE=Sponsors
AIRTABLE_FREELANCE_TABLE=Freelance
AIRTABLE_EVENTS_TABLE=Events
AIRTABLE_RECAPS_TABLE=Recaps
