# OutsideAtl environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the server listens on
PORT=3000

# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_secret

# Admin login
ADMIN_USERNAME=OutsideAdmin

# bcrypt hash of the admin password (NOT the password itself).
# Generate with:  npm run hash-password -- "yourStrongPassword"
ADMIN_PASSWORD_HASH=replace_this_with_bcrypt_hash

# Optional: custom path for the SQLite database file
# DB_PATH=./outsideatl.db
