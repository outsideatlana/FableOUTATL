# OutsideAtl environment configuration
# ---------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it holds secrets. `.env.example` is safe to commit.
# ---------------------------------------------------------------

# Port the server listens on
PORT=3000

# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_secret

# ---- Admin login ----------------------------------------------
ADMIN_USERNAME=OutsideAdmin
# bcrypt hash of the admin password (NOT the password itself).
# Generate with:  npm run hash-password -- "yourStrongPassword"
#   or:           node -e "const bcrypt=require('bcryptjs'); bcrypt.hash('OutsideAtl21@', 10).then(console.log)"
ADMIN_PASSWORD_HASH=replace_this_with_bcrypt_hash

# ---- Database -------------------------------------------------
# Currently SQLite (a local file). DATABASE_PROVIDER is reserved for a
# future Postgres/Supabase swap; only sqlite is wired up today.
DATABASE_PROVIDER=sqlite
DATABASE_URL=./outsideatl.db

# ---- Image storage -------------------------------------------
# Where uploaded images (event posters + recap photos) are stored.
# Options: local | supabase | airtable | netlify
#   local    -> ./uploads folder, served at /uploads (default, great for dev)
#   netlify  -> same on-disk behaviour (use supabase on a real Netlify deploy)
#   supabase -> Supabase Storage bucket (recommended for production/hosting)
#   airtable -> not a blob store; falls back to local disk (see note below)
STORAGE_PROVIDER=local

# ---- Supabase (DB optional today; Storage used when STORAGE_PROVIDER=supabase)
# SECURITY: the SERVICE ROLE key bypasses Row Level Security. Keep it
# SERVER-SIDE ONLY. Never expose it in frontend JavaScript or commit it.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=outsideatl-uploads

# ---- Airtable (optional mirror of submissions) ----------------
# SECURITY: AIRTABLE_API_KEY is a backend-only secret. Never ship it to
# the browser. When ENABLE_AIRTABLE_SYNC=true, records are saved to the
# local DB first, then mirrored to Airtable (failures are logged, not fatal).
ENABLE_AIRTABLE_SYNC=false
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_RSVP_TABLE=RSVPs
AIRTABLE_SIGNUPS_TABLE=Signups
AIRTABLE_APPLICATIONS_TABLE=Applications
AIRTABLE_EVENTS_TABLE=Events
AIRTABLE_RECAPS_TABLE=Recaps
